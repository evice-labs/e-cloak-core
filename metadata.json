{
  "name": "e_cloak_core",
  "display_name": "e-cloak-core",
  "version": "1.0.0",
  "type": "core",
  "interface": "universal",
  "category": "general",
  "description": "C++ Qt Plugin and cryptographic engine powered by e-identity-stack",
  "main": "e_cloak_core_plugin",
  "codegen": {
    "impl_header": "src/e_cloak_core_impl.h",
    "impl_class": "ECloakCoreImpl"
  },
  "dependencies": [],
  "nix": {
    "packages": {
      "build": ["nlohmann_json", "openssl", "zstd"],
      "runtime": ["nlohmann_json", "openssl", "zstd"]
    },
    "external_libraries": [
      {
        "name": "e_identity_sdk",
        "vendor_path": "lib"
      },
      {
        "name": "e_moderation_sdk",
        "vendor_path": "lib"
      }
    ],
    "cmake": {
      "find_packages": ["nlohmann_json", "OpenSSL", "zstd"],
      "extra_sources": [],
      "extra_include_dirs": ["lib"],
      "extra_link_libraries": ["OpenSSL::Crypto", "zstd::libzstd"]
    }
  }
}

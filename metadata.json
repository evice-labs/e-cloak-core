{
  "name": "ecloakcore",
  "display_name": "eCloak Core",
  "version": "1.0.0",
  "type": "core",
  "interface": "universal",
  "category": "general",
  "description": "eCloak Core C++ Qt Plugin and cryptographic engine by Evice Labs",
  "main": "ecloakcore_plugin",
  "codegen": {
    "impl_header": "src/el_anon_chat_core_impl.h",
    "impl_class": "ElAnonChatCoreImpl"
  },
  "dependencies": [],
  "nix": {
    "packages": {
      "build": [
        "nlohmann_json",
        "openssl",
        "zstd"
      ],
      "runtime": [
        "nlohmann_json",
        "openssl",
        "zstd"
      ]
    },
    "external_libraries": [
      {
        "name": "e_identity_sdk",
        "vendor_path": "lib"
      },
      {
        "name": "e_moderation_sdk",
        "vendor_path": "lib"
      }
    ],
    "cmake": {
      "find_packages": [
        "nlohmann_json",
        "OpenSSL",
        "zstd"
      ],
      "extra_sources": [],
      "extra_include_dirs": [
        "lib"
      ],
      "extra_link_libraries": [
        "OpenSSL::Crypto",
        "zstd::libzstd"
      ]
    }
  }
}